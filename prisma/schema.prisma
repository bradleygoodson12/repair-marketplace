generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PRO
  ADMIN
}

enum RequestStatus {
  OPEN
  QUOTED
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum BookingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
  SUBMITTED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(CUSTOMER)
  suspended     Boolean   @default(false)
  image         String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  proProfile    ProProfile?
  properties    Property[]
  requests      ServiceRequest[] @relation("CustomerRequests")
  sentMessages  Message[]
  reviewsWritten Review[]        @relation("ReviewsWritten")
  repairDocuments RepairDocument[]
  reportsFiled    Report[]       @relation("ReportsFiled")
  reportsReceived Report[]       @relation("ReportsReceived")
  notifications   Notification[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Service pro's public profile + business info. Kept separate from User so
// a customer-only account never carries pro-specific fields.
model ProProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  businessName      String
  bio               String   @db.Text
  yearsExperience   Int      @default(0)
  hourlyRateCents   Int?
  serviceRadiusMiles Int     @default(15)
  serviceZip        String
  verified          Boolean  @default(false)
  avgRating         Float    @default(0)
  reviewCount       Int      @default(0)
  // Pros are paid directly by customers outside the app and must be
  // subscribed (and admin-vetted via `verified`) to operate on the
  // platform at all — there's no per-lead fallback. stripeCustomerId is
  // the pro as a Stripe *customer* (billed), never a Connect payout account.
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   SubscriptionStatus @default(NONE)
  subscriptionCurrentPeriodEnd DateTime?
  // Pre-fill the quote form so quoting a lead doesn't start from a blank
  // slate every time. Price is deliberately not defaulted here — it varies
  // too much job to job, and a stale default is the one field that could
  // silently send a wrong number.
  defaultQuoteMessage  String?  @db.Text
  defaultDurationDays  Int?
  // Business photo shown on the public pro profile — distinct from the
  // underlying User's own account photo, since a pro's storefront image
  // isn't necessarily a headshot.
  photoUrl          String?
  licenseNumber     String?
  // Self-reported by the pro, not verified against any state licensing
  // board — license/insurance requirements vary by state and trade, so we
  // don't attempt to encode or enforce them. Shown publicly as badges with
  // a disclaimer that the customer is responsible for verifying them.
  isLicensed        Boolean  @default(false)
  isInsured         Boolean  @default(false)
  // Optional supporting documents (license copy, certificate of
  // insurance, etc.) for admins to spot-check — never required, never
  // shown publicly.
  licenseDocumentUrls String[] @default([])
  // Past-work gallery shown on the public profile — the single biggest
  // trust signal in home services ("show me what you've actually done"),
  // separate from the one storefront photoUrl above.
  portfolioUrls     String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories ProProfileCategory[]
  quotes     Quote[]
  reviews    Review[]            @relation("ReviewsReceived")
  quickQuoteTemplates QuickQuoteTemplate[]

  @@index([serviceZip])
}

// A pro's saved presets for commonly-requested jobs (e.g. "Faucet
// replacement — $150, 1 day") so quoting a familiar job is picking from a
// list instead of retyping the same numbers. Distinct from
// defaultQuoteMessage/defaultDurationDays, which is a single always-on
// fallback — these are named, swappable-in options.
model QuickQuoteTemplate {
  id           String   @id @default(cuid())
  proProfileId String
  label        String
  priceCents   Int
  durationDays Int?
  message      String?  @db.Text
  createdAt    DateTime @default(now())

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)

  @@index([proProfileId])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  icon        String

  proProfiles ProProfileCategory[]
  requests    ServiceRequest[]
  suggestedForLineItems RepairLineItem[] @relation("SuggestedFor")
  chosenForLineItems    RepairLineItem[] @relation("ChosenFor")
}

model ProProfileCategory {
  proProfileId String
  categoryId   String

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([proProfileId, categoryId])
}

// A physical address tied to a customer. Modeled independently of
// ServiceRequest so one property can accumulate multiple job requests over
// time, and so it can later be enriched from a real estate data API
// (parcel details, year built, square footage, valuation, etc.) via
// externalProvider/externalId/enrichmentData without a schema change.
model Property {
  id                 String    @id @default(cuid())
  ownerId            String
  addressLine1       String
  addressLine2       String?
  city               String
  state              String
  zip                String
  lat                Float?
  lng                Float?
  propertyType       String?   // e.g. single_family, condo, townhouse
  yearBuilt          Int?
  squareFeet         Int?
  externalProvider   String?   // e.g. "zillow", "attom", "estated"
  externalId         String?   // provider's record id for this property
  enrichmentData     Json?     // raw provider payload for future use
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner    User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requests ServiceRequest[]

  @@index([ownerId])
  @@index([zip])
}

model ServiceRequest {
  id                  String        @id @default(cuid())
  customerId          String
  propertyId          String
  categoryId          String
  title               String
  description         String        @db.Text
  status              RequestStatus @default(OPEN)
  budgetMinCents       Int?
  budgetMaxCents       Int?
  preferredDate       DateTime?
  photoUrls           String[]      @default([])
  // Lets an agent/realtor post a job for a client without creating a
  // separate account for that client — the pro still ends up talking to
  // whoever actually owns the property.
  postedAsAgent       Boolean       @default(false)
  clientName          String?
  clientEmail         String?
  clientPhone         String?
  // Set when this request was created from a RepairDocument line item, so
  // pros have a quick pointer into a long attached report instead of
  // having to search the whole thing.
  sourcePageNumber    Int?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer User      @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category Category  @relation(fields: [categoryId], references: [id])
  quotes   Quote[]
  booking  Booking?
  messages Message[]
  repairLineItem RepairLineItem?
  reports  Report[]

  @@index([customerId])
  @@index([categoryId])
  @@index([status])
}

model Quote {
  id                   String      @id @default(cuid())
  requestId            String
  proProfileId         String
  priceCents           Int
  message              String      @db.Text
  estimatedDurationDays Int?
  status               QuoteStatus @default(PENDING)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proProfile ProProfile     @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  booking    Booking?

  @@unique([requestId, proProfileId])
  @@index([requestId])
}

// Customers pay pros directly, outside the app — Booking exists only to
// track scheduling/status, never payment. The app's own revenue is tracked
// separately via ProProfile's subscription fields.
model Booking {
  id                    String        @id @default(cuid())
  requestId             String        @unique
  quoteId               String        @unique
  scheduledDate         DateTime
  status                BookingStatus @default(SCHEDULED)
  totalCents            Int
  createdAt             DateTime      @default(now())
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancelledByRole       Role?
  cancelReason          String?       @db.Text

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quote   Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  review  Review?
}

model Message {
  id        String   @id @default(cuid())
  requestId String
  senderId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Review {
  id           String    @id @default(cuid())
  bookingId    String    @unique
  proProfileId String
  customerId   String
  rating       Int
  comment      String?   @db.Text
  photoUrls    String[]  @default([])
  // The pro's single public reply to this review, shown right under it.
  proReply     String?   @db.Text
  proReplyAt   DateTime?
  createdAt    DateTime  @default(now())

  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proProfile ProProfile @relation("ReviewsReceived", fields: [proProfileId], references: [id], onDelete: Cascade)
  customer   User       @relation("ReviewsWritten", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([proProfileId])
}

// An uploaded repair-list document (inspection report, repair addendum, etc.)
// that an AI pass breaks into individual RepairLineItems. Each selected item
// becomes its own ServiceRequest once the customer reviews and submits.
// Contractors see the full source documents directly (fileUrl +
// supportingDocumentUrls) rather than an AI-cropped page image per item —
// that per-item matching proved unreliable, so it was replaced wholesale.
model RepairDocument {
  id               String         @id @default(cuid())
  customerId       String
  fileUrl          String
  originalFilename String
  status           DocumentStatus @default(PROCESSING)
  errorMessage     String?
  supportingDocumentUrls String[] @default([])
  extractedAddressLine1 String?
  extractedCity         String?
  extractedState        String?
  extractedZip          String?
  createdAt        DateTime       @default(now())

  customer  User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lineItems RepairLineItem[]

  @@index([customerId])
}

model RepairLineItem {
  id               String   @id @default(cuid())
  repairDocumentId String
  rawText          String   @db.Text
  title            String
  description      String   @db.Text
  suggestedCategoryId String?
  categoryId       String?
  pageNumber       Int?
  selected         Boolean  @default(true)
  // Customer-uploaded photos specific to this repair item, set during review
  // (separate from the whole-document attachments every request also gets).
  photoUrls        String[] @default([])
  serviceRequestId String?  @unique
  createdAt        DateTime @default(now())

  repairDocument    RepairDocument  @relation(fields: [repairDocumentId], references: [id], onDelete: Cascade)
  suggestedCategory Category?       @relation("SuggestedFor", fields: [suggestedCategoryId], references: [id])
  category          Category?       @relation("ChosenFor", fields: [categoryId], references: [id])
  serviceRequest    ServiceRequest? @relation(fields: [serviceRequestId], references: [id])

  @@index([repairDocumentId])
}

// Backs a simple Postgres rate limiter (see src/lib/rate-limit.ts) — no
// Redis/KV in this stack, and at this scale a small indexed table is plenty.
// Rows outside the checked window are pruned on each check, so this never
// grows unbounded.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  FRAUD
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// A user- or request-level flag for admin review. At least one of
// targetUserId/targetRequestId is set — enforced in the API route, not the
// schema, since Prisma doesn't support a DB-level "at least one of" check.
model Report {
  id              String       @id @default(cuid())
  reporterId      String
  targetUserId    String?
  targetRequestId String?
  reason          ReportReason
  details         String?      @db.Text
  status          ReportStatus @default(OPEN)
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?

  reporter      User            @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser    User?           @relation("ReportsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetRequest ServiceRequest? @relation(fields: [targetRequestId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetUserId])
  @@index([targetRequestId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?  @db.Text
  // Where clicking the notification should take the user.
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}
