generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled endpoint (PgBouncer, transaction mode) can't hold the
  // session-level advisory lock `prisma migrate deploy` needs to serialize
  // migrations — it just times out (P1002). directUrl routes migrations
  // through Neon's direct (non-pooled) connection instead; normal query
  // traffic still goes through the pooled `url` above.
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  PRO
  ADMIN
}

enum RequestStatus {
  OPEN
  QUOTED
  BOOKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  // Reached 72h after posting with no booking — no longer visible to pros
  // or quotable, but kept as a record the customer can see and re-submit
  // from (see lib/request-expiry.ts).
  EXPIRED
}

enum QuoteStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum BookingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingMode {
  PAY_PER_QUOTE
  SUBSCRIPTION
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
  SUBMITTED
}

enum AuthTokenKind {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(CUSTOMER)
  suspended     Boolean   @default(false)
  // Null until the owner clicks the link from their verification email —
  // login is blocked until then (see authorize() in lib/auth.ts). Pre-existing
  // and seeded accounts are backfilled so this requirement only applies
  // going forward, not retroactively.
  emailVerified DateTime?
  image         String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]

  proProfile    ProProfile?
  properties    Property[]
  requests      ServiceRequest[] @relation("CustomerRequests")
  sentMessages  Message[]
  reviewsWritten Review[]        @relation("ReviewsWritten")
  repairDocuments RepairDocument[]
  reportsFiled    Report[]       @relation("ReportsFiled")
  reportsReceived Report[]       @relation("ReportsReceived")
  notifications   Notification[]
  authTokens      AuthToken[]

  @@index([email])
}

// Single-use tokens backing email verification and password reset — a
// cryptographically random string (not a cuid, which isn't meant to be
// secret), short-lived, deleted once consumed.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  kind      AuthTokenKind
  token     String        @unique
  expiresAt DateTime
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Service pro's public profile + business info. Kept separate from User so
// a customer-only account never carries pro-specific fields.
model ProProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  businessName      String
  bio               String   @db.Text
  yearsExperience   Int      @default(0)
  hourlyRateCents   Int?
  serviceRadiusMiles Int     @default(15)
  serviceZip        String
  // Derived from serviceZip on every save (see lib/capacity.ts) — the unit
  // the per-category capacity cap is scoped to. Nullable only because it's
  // backfilled lazily; every profile created or edited going forward gets
  // one set.
  serviceCity       String?
  serviceState      String?
  verified          Boolean  @default(false)
  avgRating         Float    @default(0)
  reviewCount       Int      @default(0)
  // Pros are paid directly by customers outside the app — the only money
  // the app ever charges a pro is for sending quotes, either a flat fee
  // per quote or via subscription. billingMode is the pro's current
  // choice of the two; defaults to the lower-commitment pay-per-quote
  // option so a new pro can try the platform before committing to a
  // monthly fee. stripeCustomerId is the pro as a Stripe *customer*
  // (billed), never a Connect payout account.
  billingMode          BillingMode        @default(PAY_PER_QUOTE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   SubscriptionStatus @default(NONE)
  subscriptionCurrentPeriodEnd DateTime?
  // A Stripe Connect Express account used ONLY for identity/business
  // verification (real KYC: business details, EIN, bank account) — we
  // never create a Transfer or Charge against it. This strengthens what
  // "Verified" means without turning Repair Bee into a payment processor
  // for the repair job itself (see Terms of Service).
  stripeConnectAccountId         String?
  stripeConnectDetailsSubmitted  Boolean   @default(false)
  stripeConnectVerifiedAt        DateTime?
  // Pre-fill the quote form so quoting a lead doesn't start from a blank
  // slate every time. Price is deliberately not defaulted here — it varies
  // too much job to job, and a stale default is the one field that could
  // silently send a wrong number.
  defaultQuoteMessage  String?  @db.Text
  defaultDurationDays  Int?
  // Set by the daily stale-bidding check (api/cron/check-stale-bids) when
  // this pro is flagged for not bidding on matching leads — throttles
  // repeat admin alerts about the same pro to once a week.
  lastBiddingAlertAt   DateTime?
  // Same daily check, same once-a-week throttle, but for the two other
  // quality signals: a bad-review ratio (lastReviewQualityAlertAt) and a
  // high lead-decline rate (lastDeclineRateAlertAt). Kept as separate
  // fields from lastBiddingAlertAt so flagging one issue doesn't silence
  // alerts about a different one for the same pro.
  lastReviewQualityAlertAt DateTime?
  lastDeclineRateAlertAt   DateTime?
  // Business photo shown on the public pro profile — distinct from the
  // underlying User's own account photo, since a pro's storefront image
  // isn't necessarily a headshot.
  photoUrl          String?
  licenseNumber     String?
  // Self-reported by the pro, not verified against any state licensing
  // board — license/insurance requirements vary by state and trade, so we
  // don't attempt to encode or enforce them. Shown publicly as badges with
  // a disclaimer that the customer is responsible for verifying them.
  isLicensed        Boolean  @default(false)
  isInsured         Boolean  @default(false)
  // Optional supporting documents (license copy, certificate of
  // insurance, etc.) for admins to spot-check — never required, never
  // shown publicly.
  licenseDocumentUrls String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories ProProfileCategory[]
  quotes     Quote[]
  reviews    Review[]            @relation("ReviewsReceived")
  quickQuoteTemplates QuickQuoteTemplate[]
  waitlistEntries     CategoryWaitlistEntry[]
  leadDismissals      ProLeadDismissal[]
  // Past-work gallery shown on the public profile — the single biggest
  // trust signal in home services ("show me what you've actually done"),
  // separate from the one storefront photoUrl above. A real table (not a
  // plain string array) so each photo can carry its own caption.
  portfolioPhotos     PortfolioPhoto[]

  @@index([serviceZip])
  @@index([serviceCity, serviceState])
}

model PortfolioPhoto {
  id           String   @id @default(cuid())
  proProfileId String
  url          String
  caption      String?
  // Display order on the public profile and in the dashboard editor —
  // reassigned to match array position on every save, so dragging isn't
  // needed to reorder, just re-save with the new order.
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)

  @@index([proProfileId])
}

enum WaitlistStatus {
  WAITING
  OFFERED
  EXPIRED
  CLAIMED
  DECLINED
}

// Each category is capped at CATEGORY_CAPACITY_PER_CITY active (verified,
// non-suspended) pros per city — see lib/capacity.ts. A pro who tries to
// add a full category joins this waitlist instead; when a slot frees up
// (a pro drops the category, gets suspended, or loses verification), the
// oldest WAITING entry for that category+city is offered the spot with a
// time-limited claim window (see api/cron/check-waitlist-expiry).
model CategoryWaitlistEntry {
  id             String         @id @default(cuid())
  proProfileId   String
  categoryId     String
  city           String
  state          String
  status         WaitlistStatus @default(WAITING)
  offeredAt      DateTime?
  offerExpiresAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([proProfileId, categoryId, city, state])
  @@index([categoryId, city, state, status, createdAt])
}

// A pro's saved presets for commonly-requested jobs (e.g. "Faucet
// replacement — $150, 1 day") so quoting a familiar job is picking from a
// list instead of retyping the same numbers. Distinct from
// defaultQuoteMessage/defaultDurationDays, which is a single always-on
// fallback — these are named, swappable-in options.
model QuickQuoteTemplate {
  id           String   @id @default(cuid())
  proProfileId String
  label        String
  priceCents   Int
  durationDays Int?
  message      String?  @db.Text
  createdAt    DateTime @default(now())

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)

  @@index([proProfileId])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  icon        String

  proProfiles ProProfileCategory[]
  requests    ServiceRequest[]
  suggestedForLineItems RepairLineItem[] @relation("SuggestedFor")
  chosenForLineItems    RepairLineItem[] @relation("ChosenFor")
  waitlistEntries       CategoryWaitlistEntry[]
}

model ProProfileCategory {
  proProfileId String
  categoryId   String

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([proProfileId, categoryId])
}

// A physical address tied to a customer. Modeled independently of
// ServiceRequest so one property can accumulate multiple job requests over
// time, and so it can later be enriched from a real estate data API
// (parcel details, year built, square footage, valuation, etc.) via
// externalProvider/externalId/enrichmentData without a schema change.
model Property {
  id                 String    @id @default(cuid())
  ownerId            String
  addressLine1       String
  addressLine2       String?
  city               String
  state              String
  zip                String
  lat                Float?
  lng                Float?
  propertyType       String?   // e.g. single_family, condo, townhouse
  yearBuilt          Int?
  squareFeet         Int?
  externalProvider   String?   // e.g. "zillow", "attom", "estated"
  externalId         String?   // provider's record id for this property
  enrichmentData     Json?     // raw provider payload for future use
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner    User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requests ServiceRequest[]

  @@index([ownerId])
  @@index([zip])
}

model ServiceRequest {
  id                  String        @id @default(cuid())
  customerId          String
  propertyId          String
  categoryId          String
  title               String
  description         String        @db.Text
  status              RequestStatus @default(OPEN)
  budgetMinCents       Int?
  budgetMaxCents       Int?
  preferredDate       DateTime?
  photoUrls           String[]      @default([])
  // Lets an agent/realtor post a job for a client without creating a
  // separate account for that client — the pro still ends up talking to
  // whoever actually owns the property.
  postedAsAgent       Boolean       @default(false)
  clientName          String?
  clientEmail         String?
  clientPhone         String?
  // Extra recipients (e.g. the agent's buyer/seller) who get a copy of every
  // quote notification for this request, so everyone sees the same thing
  // without the agent forwarding emails by hand.
  ccEmails            String[]      @default([])
  // Customer/agent checked a box at submission saying they'd welcome a
  // pay-at-closing arrangement if a pro is willing to offer it — shown to
  // pros on the lead as a factor in deciding whether/how to bid. Not a
  // guarantee or a term Repair Bee enforces; pros and customers still work
  // out payment directly between themselves.
  payAtCloseRequested Boolean       @default(false)
  // Set when this request was created from a RepairDocument line item, so
  // pros have a quick pointer into a long attached report instead of
  // having to search the whole thing.
  sourcePageNumber    Int?
  // Set once the 48h-unquoted reminder email has gone out to matching pros,
  // so a daily cron check doesn't resend it every run (see
  // lib/request-expiry.ts).
  expiryReminderSentAt DateTime?
  // Set once this (now-expired) request's quotes have been folded into a
  // property-level recap sent to the customer/agent — see
  // lib/quote-recap.ts. Tracked per request rather than per property so a
  // later batch of requests on the same address still gets its own recap.
  quoteRecapSentAt    DateTime?
  // Set when this request traces back to an inspector's referral link (see
  // InspectorPartner) — carried over from the RepairDocument it was created
  // from, if any, so referral performance can be queried per request/status
  // without walking back through the document each time.
  referredByInspectorId String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer User      @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category Category  @relation(fields: [categoryId], references: [id])
  quotes   Quote[]
  booking  Booking?
  messages Message[]
  repairLineItem RepairLineItem?
  reports  Report[]
  leadDismissals ProLeadDismissal[]
  referredByInspector InspectorPartner? @relation(fields: [referredByInspectorId], references: [id])

  @@index([customerId])
  @@index([categoryId])
  @@index([status])
  @@index([referredByInspectorId])
}

// Lets a pro clear a lead off their own dashboard without touching the
// request itself — it still shows to every other matching pro, and the
// customer sees no change. A pro who changes their mind can still quote
// it directly from the request's own page; this only affects their lead
// list.
model ProLeadDismissal {
  id               String   @id @default(cuid())
  proProfileId     String
  serviceRequestId String
  createdAt        DateTime @default(now())

  proProfile     ProProfile     @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@unique([proProfileId, serviceRequestId])
  @@index([serviceRequestId])
}

model Quote {
  id                   String      @id @default(cuid())
  requestId            String
  proProfileId         String
  priceCents           Int
  // Set only for a range estimate, where it's the high end (priceCents is
  // the low end) — null for an exact price or a single-number estimate.
  // Implies isEstimate: true is enforced server-side whenever this is set,
  // since a range is inherently not a firm bid.
  priceMaxCents        Int?
  // Whether priceCents (or the priceCents–priceMaxCents range) is the pro's
  // firm bid or a rough estimate subject to change once they're on site —
  // shown to the customer as a label. A range quote can still be accepted
  // directly; the booking is created at the low end (priceCents), with any
  // higher final cost billed as a Change Order once the pro is on site —
  // same path as any other scope change discovered after booking.
  isEstimate           Boolean     @default(false)
  message              String      @db.Text
  estimatedDurationDays Int?
  status               QuoteStatus @default(PENDING)
  // A pay-per-quote pro owes this flat fee to send the quote — null for a
  // subscriber (quoting is free, unlimited). Set once at submission time
  // from the pro's subscription status then, not recomputed later, so a
  // later subscription change doesn't retroactively alter a quote already
  // sent. While owed and unpaid, the quote exists but is held back from
  // the customer and other pros (see requests/[id]/page.tsx) until paid.
  quoteFeeRequiredCents Int?
  quoteFeePaidAt         DateTime?
  stripeSessionId        String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proProfile ProProfile     @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  booking    Booking?

  @@unique([requestId, proProfileId])
  @@index([requestId])
}

// Customers pay pros directly, outside the app — Booking exists only to
// track scheduling/status, never payment. The app's own revenue is tracked
// separately via ProProfile's subscription fields.
model Booking {
  id                    String        @id @default(cuid())
  requestId             String        @unique
  quoteId               String        @unique
  scheduledDate         DateTime
  status                BookingStatus @default(SCHEDULED)
  totalCents            Int
  createdAt             DateTime      @default(now())
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancelledByRole       Role?
  cancelReason          String?       @db.Text
  // Pure record-keeping uploads from the pro — Repair Bee never generates,
  // validates, or processes payment against these; it's the same role the
  // app already plays for license/portfolio documents elsewhere.
  invoiceUrls           String[]      @default([])
  warrantyUrls          String[]      @default([])
  // Set once the reminder cron has notified both sides about this
  // scheduledDate — cleared whenever scheduledDate changes, so moving the
  // appointment re-arms the reminder instead of silently staying sent.
  reminderSentAt        DateTime?

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quote   Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  review  Review?
  updates ProjectUpdate[]
  changeOrders ChangeOrder[]
}

enum ChangeOrderStatus {
  PENDING
  APPROVED
  DECLINED
}

// Additional work a pro proposes once a booking is already underway —
// billed the same way as an initial quote (a flat fee per submission for a
// pay-per-quote pro, free for a subscriber), and held back from the
// customer until that fee clears, exactly like Quote.quoteFeeRequiredCents.
// Approving bumps Booking.totalCents by additionalPriceCents.
model ChangeOrder {
  id                   String            @id @default(cuid())
  bookingId            String
  description          String            @db.Text
  additionalPriceCents Int
  status               ChangeOrderStatus @default(PENDING)
  feeRequiredCents     Int?
  feePaidAt            DateTime?
  stripeSessionId      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// A progress update the pro posts while a booking is active — a short note
// plus any number of photos, shown to the customer in chronological order.
model ProjectUpdate {
  id        String   @id @default(cuid())
  bookingId String
  note      String   @db.Text
  photoUrls String[] @default([])
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Message {
  id        String   @id @default(cuid())
  requestId String
  senderId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  sender  User           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Review {
  id           String    @id @default(cuid())
  bookingId    String    @unique
  proProfileId String
  customerId   String
  rating       Int
  comment      String?   @db.Text
  photoUrls    String[]  @default([])
  // The pro's single public reply to this review, shown right under it.
  proReply     String?   @db.Text
  proReplyAt   DateTime?
  createdAt    DateTime  @default(now())

  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  proProfile ProProfile @relation("ReviewsReceived", fields: [proProfileId], references: [id], onDelete: Cascade)
  customer   User       @relation("ReviewsWritten", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([proProfileId])
}

// An uploaded repair-list document (inspection report, repair addendum, etc.)
// that an AI pass breaks into individual RepairLineItems. Each selected item
// becomes its own ServiceRequest once the customer reviews and submits.
// Contractors see the full source documents directly (fileUrl +
// supportingDocumentUrls) rather than an AI-cropped page image per item —
// that per-item matching proved unreliable, so it was replaced wholesale.
model RepairDocument {
  id               String         @id @default(cuid())
  customerId       String
  fileUrl          String
  originalFilename String
  status           DocumentStatus @default(PROCESSING)
  errorMessage     String?
  supportingDocumentUrls String[] @default([])
  extractedAddressLine1 String?
  extractedCity         String?
  extractedState        String?
  extractedZip          String?
  // Set when the upload came in through an inspector's referral link (see
  // InspectorPartner) — carried forward onto each ServiceRequest created at
  // submit time, since one document can become several requests.
  referredByInspectorId String?
  createdAt        DateTime       @default(now())

  customer  User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lineItems RepairLineItem[]
  referredByInspector InspectorPartner? @relation(fields: [referredByInspectorId], references: [id])

  @@index([customerId])
  @@index([referredByInspectorId])
}

// A home inspector (or inspection company) whose clients get referred to
// Repair Bee via a dedicated link/QR code after their inspection. Created by
// an admin for now (see /admin/inspectors) rather than self-serve signup —
// referral volume is low enough in the pilot phase that hand-onboarding is
// simpler than building a signup flow nobody's asked for yet.
model InspectorPartner {
  id           String   @id @default(cuid())
  slug         String   @unique
  companyName  String
  contactName  String?
  contactEmail String?
  contactPhone String?
  // Shown on the co-branded landing page (/inspectors/[slug]); optional since
  // not every inspector will have one on hand at onboarding time.
  logoUrl      String?
  // Lets a referral link be switched off (e.g. a pilot ends) without losing
  // the historical attribution on requests it already generated.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  repairDocuments RepairDocument[]
  serviceRequests ServiceRequest[]
}

model RepairLineItem {
  id               String   @id @default(cuid())
  repairDocumentId String
  rawText          String   @db.Text
  title            String
  description      String   @db.Text
  suggestedCategoryId String?
  categoryId       String?
  pageNumber       Int?
  selected         Boolean  @default(true)
  // Customer-uploaded photos specific to this repair item, set during review
  // (separate from the whole-document attachments every request also gets).
  photoUrls        String[] @default([])
  serviceRequestId String?  @unique
  createdAt        DateTime @default(now())

  repairDocument    RepairDocument  @relation(fields: [repairDocumentId], references: [id], onDelete: Cascade)
  suggestedCategory Category?       @relation("SuggestedFor", fields: [suggestedCategoryId], references: [id])
  category          Category?       @relation("ChosenFor", fields: [categoryId], references: [id])
  serviceRequest    ServiceRequest? @relation(fields: [serviceRequestId], references: [id])

  @@index([repairDocumentId])
}

// Backs a simple Postgres rate limiter (see src/lib/rate-limit.ts) — no
// Redis/KV in this stack, and at this scale a small indexed table is plenty.
// Rows outside the checked window are pruned on each check, so this never
// grows unbounded.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Captured by reportAdminError (src/lib/admin-alerts.ts) — either from the
// global Next.js onRequestError hook (src/instrumentation.ts), which catches
// any error that escapes a route/render uncaught, or from a specific
// deliberately-caught failure path that's worth surfacing on its own (e.g.
// PDF extraction). Admin alert emails are rate-limited per source, but every
// occurrence still lands here so nothing is lost between alerts.
model ErrorLog {
  id         String    @id @default(cuid())
  source     String
  message    String    @db.Text
  stack      String?   @db.Text
  context    Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([resolvedAt])
}

enum ReportReason {
  SPAM
  INAPPROPRIATE
  FRAUD
  INCOMPLETE_WORK
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// A user- or request-level flag for admin review. At least one of
// targetUserId/targetRequestId is set — enforced in the API route, not the
// schema, since Prisma doesn't support a DB-level "at least one of" check.
model Report {
  id              String       @id @default(cuid())
  reporterId      String
  targetUserId    String?
  targetRequestId String?
  reason          ReportReason
  details         String?      @db.Text
  status          ReportStatus @default(OPEN)
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?

  reporter      User            @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser    User?           @relation("ReportsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetRequest ServiceRequest? @relation(fields: [targetRequestId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetUserId])
  @@index([targetRequestId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?  @db.Text
  // Where clicking the notification should take the user.
  url       String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}
