# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/repair_marketplace"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Optional: a pre-created recurring Price for the pro subscription (Products
# > Repair Bee pro subscription > $20/month in the Stripe dashboard, or via
# `stripe prices create`). Without it, checkout creates an ad-hoc price on
# every session instead — works fine, but every subscriber's Price shows up
# separately in Stripe's own reporting instead of rolling up to one. Set
# this once you've created the Price.
# STRIPE_SUBSCRIPTION_PRICE_ID="price_..."

# Vercel Blob (job photos + uploaded repair documents)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Anthropic (parses uploaded repair-list PDFs into line items)
ANTHROPIC_API_KEY="sk-ant-..."

# Resend (email notifications to pros: new leads, messages, accepted quotes,
# subscription issues). Without it, these are logged to the console instead
# of sent — nothing breaks, pros just don't get emailed.
RESEND_API_KEY="re_..."
# Sandbox sender (default) only delivers to your own Resend account email.
# Once you verify a domain in Resend, switch this to an address on it, e.g.
# RESEND_FROM_EMAIL="Repair Bee <notifications@yourdomain.com>"
# RESEND_FROM_EMAIL="Repair Bee <onboarding@resend.dev>"

# Future: real estate / property enrichment provider (e.g. Zillow, Estated, ATTOM)
# REAL_ESTATE_API_KEY=""
# REAL_ESTATE_API_PROVIDER=""

# Sentry (error monitoring). Without NEXT_PUBLIC_SENTRY_DSN, Sentry.init()
# no-ops everywhere (client, server, edge) — nothing breaks, errors just
# aren't reported anywhere. ORG/PROJECT/AUTH_TOKEN are build-time only (CI),
# used solely to upload source maps for readable stack traces; leave unset
# anywhere else.
# NEXT_PUBLIC_SENTRY_DSN="https://...@o0.ingest.sentry.io/0"
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="your-project-slug"
# SENTRY_AUTH_TOKEN="sntrys_..."
